# URL of the edtech-monad-api Worker (baked in at build time by Vite)
VITE_API_URL=http://localhost:8787
# Privy App ID (public). Create the app in the Privy dashboard, then paste here.
# This is the ONLY Privy value allowed in the web bundle — never put the App Secret here.
VITE_PRIVY_APP_ID=your-privy-app-id
# Optional override (defaults to the Monad testnet deployment)
# VITE_MARKETPLACE_ADDRESS=0xC8c9Cd5A19b4FC27B209AdF75eDA442C798Ab59e
