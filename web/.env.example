# Same-origin `/api` is used in the browser (web Worker proxies to edtech-monad-api).
# VITE_API_URL is only a fallback for local SSR without the Cloudflare binding.
VITE_API_URL=http://localhost:8787
# Public Privy App ID (the only Privy value allowed in the web bundle).
